# NextRupee — environment template. Copy to .env; never commit real values.

APP_ENV=local

# Supabase (leave blank for offline/in-memory mode)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LLM via OpenRouter (OpenAI-compatible; free routes rate-limited ~20/min, ~200/day)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=z-ai/glm-4.5-air:free
LLM_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_DAILY_REQUEST_CAP=180

# Data feeds
FRED_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
